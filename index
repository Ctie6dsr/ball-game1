import numpy as np
import matplotlib.pyplot as plt
from matplotlib.animation import FuncAnimation

m = 1
v0 = 2
r = 0.5
dt = 0.01
total_time = 10

balls = [
    {'m': 2*m, 'x': 0, 'v': v0, 'color': 'blue'},
    {'m': 2*m, 'x': 2*r, 'v': 0, 'color': 'green'},
    {'m': m, 'x': 4*r, 'v': 0, 'color': 'red'},
    {'m': m, 'x': 6*r, 'v': 0, 'color': 'purple'}
]

fig, ax = plt.subplots()
ax.set_xlim(-1, 10*r + 1)
ax.set_ylim(-1, 1)
ax.set_aspect('equal', 'box')
ax.axis('off')

ball_patches = [plt.Circle((ball['x'], 0), r, color=ball['color']) for ball in balls]
for patch in ball_patches:
    ax.add_patch(patch)

def handle_collisions(balls, dt):
    n = len(balls)
    for i in range(n - 1):
        ball1 = balls[i]
        ball2 = balls[i + 1]
        if abs(ball1['x'] - ball2['x']) <= 2 * r and ball1['v'] > ball2['v']:
            m1, v1 = ball1['m'], ball1['v']
            m2, v2 = ball2['m'], ball2['v']
            v1_new = (m1 - m2) * v1 / (m1 + m2) + 2 * m2 * v2 / (m1 + m2)
            v2_new = (m2 - m1) * v2 / (m1 + m2) + 2 * m1 * v1 / (m1 + m2)
            ball1['v'] = v1_new
            ball2['v'] = v2_new
            overlap = 2 * r - abs(ball1['x'] - ball2['x'])
            if overlap > 0:
                ball1['x'] -= overlap / 2
                ball2['x'] += overlap / 2

def update(frame):
    for i, ball in enumerate(balls):
        ball['x'] += ball['v'] * dt
    handle_collisions(balls, dt)
    for i, patch in enumerate(ball_patches):
        patch.set_center((balls[i]['x'], 0))
    return ball_patches

ani = FuncAnimation(fig, update, frames=np.arange(0, total_time, dt), interval=dt*1000, blit=True)
plt.show()
